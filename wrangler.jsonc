// The whole app: dist/ (vite build) as Workers Static Assets served from the edge, and the Worker
// (worker/index.ts) only for /api/*. Public, reachable only as train.deyaochen.com;
// no workers.dev or preview hostnames.
{
  "name": "china-train",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "train.deyaochen.com/*", "zone_name": "deyaochen.com" }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
