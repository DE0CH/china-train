# Function/middleware env. Source of truth = GitHub Actions secrets (repo Settings → Secrets):
# the deploy workflow pushes them into the Vercel project env on every deploy. Nothing is asked of
# the user in the browser.
# PROXY_URL=http://user:pass_country-cn@geo.iproyal.com:12321   # IPRoyal residential sub-user (secret)
# IPROYAL_API=…                                                 # IPRoyal management token (secret) – for /api/proxy-status
# IPROYAL_SUBUSER_HASH=…                                        # the sub-user behind PROXY_URL (secret)
# CF_ACCESS_TEAM_DOMAIN=de0ch.cloudflareaccess.com              # set in the workflow (not secret)
# CF_ACCESS_AUD=…                                               # Access app audience tag (workflow)
# PUBLIC_HOST=train.deyaochen.com                               # the guarded hostname (workflow)
